# ASR backend: wetype (default, no API key), or dashscope
AUDIO2TEXT_ASR_BACKEND=wetype

# Optional: WeType identity cache (compatible with wetype-x11 identity.json)
# Default: ~/.cache/audio2text/wetype-identity.json (respects XDG_CACHE_HOME)
# AUDIO2TEXT_WETYPE_IDENTITY=/path/to/identity.json

# WeType: finalize and append after this much silence (ms, 200-6000)
# AUDIO2TEXT_WETYPE_SEGMENT_SILENCE_MS=1000
# WeType local RMS speech threshold (0-1, exclusive of 0): lower for a quiet mic,
# higher if background noise prevents pause detection. Default is 0.01.
# AUDIO2TEXT_WETYPE_VOICE_THRESHOLD=0.01

# DashScope API Key (only required when AUDIO2TEXT_ASR_BACKEND=dashscope)
# Get your API key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# DashScope-only options below (except AUDIO2TEXT_DUMP_WAV)
# Optional: language hints (comma-separated, max 4)
# AUDIO2TEXT_LANGUAGE_HINTS=zh,en

# Optional: hotword file (default: ~/.config/audio2text/hotwords.txt if it exists)
# AUDIO2TEXT_HOTWORDS=/path/to/hotwords.txt

# Optional: server VAD (far_field_meeting_16k = longer segments, near_meeting_16k = splits on short pauses)
# AUDIO2TEXT_VAD_MODEL=far_field_meeting_16k

# Optional: VAD sensitivity [-1.0, 1.0]; lower if the first word gets dropped
# AUDIO2TEXT_SPEECH_NOISE_THRESHOLD=-0.1

# Optional: silence (ms, 200-6000) that ends a sentence (server default 1300)
# AUDIO2TEXT_MAX_SENTENCE_SILENCE=2000

# Optional: split sentences by meaning instead of silence (server default false)
# AUDIO2TEXT_SEMANTIC_PUNCTUATION=true

# Optional: dump the audio sent to the ASR service for debugging
# AUDIO2TEXT_DUMP_WAV=/tmp/audio2text-sent.wav
